PORT=8787
HOST=0.0.0.0

# Authentication Configuration:
# - For local development (TUNNEL=false), leaving AUTH_TOKEN blank auto-generates a secure token.
# - For remote access (TUNNEL=true), a strong AUTH_TOKEN of at least 16 characters is required.
# DO NOT use default placeholders like 'change-this-token', 'admin', or 'password'.
AUTH_TOKEN=your-secure-token-here-min-16-chars

# Tunnel Configuration:
# - Set TUNNEL=true to expose TermBridge securely over the internet via Cloudflare Tunnel.
# - Set TUNNEL=false for local/LAN access only.
TUNNEL=false

# Optional custom path to cloudflared executable:
# CLOUDFLARED_PATH=C:\Program Files (x86)\cloudflared\cloudflared.exe
